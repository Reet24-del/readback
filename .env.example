# Copy this file to .env and paste your AssemblyAI API key after the "=".
ASSEMBLYAI_API_KEY=

# Required before enabling outbound SMS; also protects the app API.
READBACK_PASSCODE=
READBACK_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Prefer an SMS-only Messaging Service; alternatively use an SMS-capable number.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
# Public HTTPS URL, also used to validate Twilio signatures behind a reverse proxy.
READBACK_SMS_STATUS_URL=https://your-host.example/api/sms/status
# Optional; keep this SQLite file on persistent storage.
# READBACK_SMS_DB=/path/to/sms.sqlite3
